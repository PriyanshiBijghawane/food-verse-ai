# Food Verse AI — Environment Variables Template
# Copy this file to .env and configure your keys if using cloud AI providers.
# The application automatically falls back to local computer vision and
# dynamic culinary intelligence when API keys are not provided.

# Groq API Key (Optional: enables Groq LLaMA-3.2 Vision in Restaurant Hygiene and LLaMA-3.3 in Smart Cooking)
GROQ_API_KEY=

# OpenAI API Key (Optional: alternative LLM backend for Recipe and Meal Planning)
OPENAI_API_KEY=

# Host and Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
